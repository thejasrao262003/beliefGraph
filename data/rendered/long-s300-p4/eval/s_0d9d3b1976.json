  ],
  "m_a3a4": [
   "AeroSwift Charter operates 6 emergency rescue helicopters, exceeding the required minimum of 4."
  ],
  "m_ecbf": [
   "AeroSwift Charter has emergency air support status, satisfying the disaster response qualification requirement."
  ],
  "m_c2c0": [
   "AeroSwift Charter holds disaster response qualification, making it eligible for government contracts."
  ],
  "m_488c": [
   "BlueSky Freight maintains 5 maintenance hangars and 20 flight crews, satisfying the set requirement of at least 4 hangars and 15 crews.",
   "BlueSky Freight operates 8 heavy-lift cargo freighters, satisfying the alternative requirement of at least 6 heavy-lift freighters."
  ],
  "m_af2d": [
   "BlueSky Freight holds 15 priority landing slots, satisfying the threshold of at least 10 slots.",
   "BlueSky Freight maintains an annual safety rating of 95 percent, meeting the minimum required score of 90 percent."
  ],
  "m_fbe9": [
   "BlueSky Freight holds priority flight scheduling designation and possesses an IATA Cargo Gold Certification, meeting both conditions for premium charter status."
  ],
  "m_6a8d": [
   "BlueSky Freight has achieved premium charter status, qualifying it for routing preference."
  ],
  "m_0062": [
   "BlueSky Freight operates 10 regional dispatch hubs, satisfying the threshold of at least 8 hubs.",
   "BlueSky Freight holds 15 priority landing slots, satisfying the threshold of at least 10 slots.",
   "BlueSky Freight operates 8 heavy-lift cargo freighters, satisfying the threshold of at least 6 freighters."
  ],
  "m_4ff9": [
   "BlueSky Freight holds network distribution capacity approval and possesses a Global Customs Clearance Permit, satisfying both requirements for international freight eligibility."
  ],
  "m_e6ea": [
   "BlueSky Freight meets international freight eligibility, satisfying the condition for overseas expansion approval."
  ],
  "m_7186": [
   "Oceanic Express operates 14 container vessels, exceeding the minimum threshold of 10 vessels."
  ],
  "m_cf1d": [
   "Oceanic Express holds deep-sea vessel compliance and possesses an International Maritime Safety Certificate, fulfilling the requirement for comprehensive shipping authorization."
  ],
  "m_ad71": [
   "Oceanic Express holds comprehensive shipping authorization, qualifying it for transatlantic corridor rights."
  ],
  "m_ce26": [
   "Orient Logistics manages 15 distribution warehouses this year, exceeding the threshold of 10."
  ],
  "m_b554": [
   "Polaris Haulage maintains a fleet age average of 3 years, which is within the maximum allowed average of 5 years."
  ],
  "m_1702": [
   "Summit Aviation holds 5 regional airport licenses, satisfying the requirement of at least 2 licenses."
  ],
  "m_837e": [
   "Meridian Port operates 50 cargo cranes, exceeding the requirement of at least 40 cranes."
  ]
