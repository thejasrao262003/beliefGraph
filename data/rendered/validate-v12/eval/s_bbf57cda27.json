 "world": "Travel logistics operators are evaluated for dispatch privileges, passenger flight clearances, and terminal dock access.",
 "rationale": {
  "m_dc31": [
   "Having an active fleet size of 15 aircraft satisfies the minimum fleet threshold of 10 aircraft to qualify as a heavy fleet carrier."
  ],
  "m_23c2": [
   "Being designated as a heavy fleet operator along with an annual safety compliance rating of 98 percent satisfies the 95 percent threshold required for tier-one dispatch clearance."
  ],
  "m_45d3": [
   "Holding tier-one flight dispatch approval satisfies the policy requirement to be selected for the priority freight contract."
  ],
  "m_f35c": [
   "Holding an active international tour operator license meets the mandate for cross-border travel authorization."
  ],
  "m_63e7": [
   "Handling an annual volume of 50000 metric tons of cargo exceeds the 40000 metric tons minimum threshold required for deep-water dock privileges."
  ]
 },
