  ],
  "m_926a": [
   "Beacon Clinic maintains 8 board-certified physicians, satisfying the minimum requirement of 5.",
   "Beacon Clinic logged a patient satisfaction score of 92 percent, satisfying the minimum requirement of 80 percent."
  ],
  "m_7741": [
   "Apex Health System logged 4 patient data privacy incidents last year, which is within the maximum allowed threshold of 5."
  ],
  "m_61ec": [
   "Apex Health System has 12 certified HIPAA compliance officers and a cybersecurity risk score of 85 points, satisfying both threshold requirements."
  ],
  "m_bc02": [
   "Apex Health System holds primary digital infrastructure safeguard clearance and conducts 6 emergency drills per year, exceeding the 4-drill minimum."
  ],
  "m_4608": [
   "Apex Health System holds verified safety operational status and maintains $10,000,000 in annual liability coverage, above the $5,000,000 threshold."
  ],
  "m_a5f8": [
   "Crestview Hospice maintains 5 specialized palliative care units, exceeding the required threshold of 3."
  ],
  "m_d71f": [
   "Delmar Pharmacy logged 0 prescription dispensing errors last year, remaining below the limit of 2."
  ],
  "m_f24f": [
   "Echo Diagnostics maintains 3 ISO-certified imaging machines, meeting the requirement of at least 2."
  ],
  "m_ba1c": [
