 "world": "An enterprise vendor procurement assessment evaluates potential IT service suppliers, transport providers, and software vendors against corporate compliance and operational benchmarks.",
 "rationale": {
  "m_a3ea": [
   "Operating 3 regional service hubs meets the policy threshold of at least 2 regional service hubs."
  ],
  "m_3311": [
   "Operating 3 regional service hubs meets the policy threshold of at least 2 regional service hubs.",
   "Holding SOC 2 Type II compliance satisfies the alternative qualification requirement."
  ],
  "m_2324": [
   "Achieving entry-level vendor eligibility satisfies the requirement for inclusion on the approved vendor list."
  ],
  "m_8f76": [
   "Holding a client satisfaction rating of 92% (at or above 85%) while operating 3 regional service hubs (at least 2) satisfies the first alternative condition.",
   "Completing 15 enterprise deployments last quarter meets the alternative policy threshold of 10 or more enterprise deployments last quarter."
  ],
  "m_25ed": [
   "Demonstrating robust commercial success alongside liability insurance coverage of $5,000,000 (at or above $3,000,000) satisfies the contract negotiation requirements."
  ],
  "m_00e5": [
   "Holding SOC 2 Type II compliance fulfills the technical operational standard.",
   "Maintaining an issue response time of 2 hours satisfies the threshold of under 4 hours.",
   "Demonstrating network availability of 99.9% meets the minimum threshold of 99.5%."
  ],
  "m_7978": [
   "Fulfilling technical operational standards and being cleared for priority contract discussions together satisfy tier-one contractor requirements."
  ],
  "m_dea9": [
   "Holding tier-one contractor status satisfies the requirement for primary vendor designation."
  ],
  "m_3c80": [
   "Holding primary vendor status while providing a 30-day evaluation period (at least 14 days) satisfies the contract execution requirements."
  ],
  "m_1cb8": [
   "Operating 50 delivery trucks meets the minimum fleet policy threshold of 30 delivery trucks."
  ],
  "m_2fd4": [
   "Holding ISO 27001 certification satisfies information security clearance requirements."
  ]
 },
