 "world": "Healthcare facilities and associated providers are evaluated for regulatory compliance, funding eligibility, and operating authorizations.",
 "rationale": {
  "m_bebf": [
   "Completing 12 compliance modules satisfies the minimum requirement of 10 modules annually."
  ],
  "m_9aab": [
   "Holding educational standards approval together with a patient safety index of 92 (above the 85 threshold) grants Tier-1 clinical status."
  ],
  "m_2410": [
   "Attaining Tier-1 clinical status alongside submitting 4 audit reviews (meeting the 3-review minimum) justifies expanding the operating license."
  ],
  "m_a019": [
   "Holding an active ISO 9001 certification, an infection control score of 95 (>= 90), and 15 annual hygiene inspections (>= 10) jointly satisfy maximum safety compliance requirements."
  ],
  "m_03d5": [
   "An infection control score of 95 satisfies the baseline threshold of 80 or higher.",
   "An external sanitation rating of 88 satisfies the alternative threshold of 75 or higher."
  ],
  "m_333f": [
   "Possessing baseline hygiene approval fulfills the requirement for renewing the surgical center permit."
  ],
  "m_2f05": [
   "Completing 12 compliance modules satisfies the operational standing threshold of at least 8 modules annually."
  ],
  "m_877c": [
   "Maintaining active standing and securing a broadened operational permit together qualify the facility for public healthcare funding."
  ],
  "m_1302": [
   "Qualifying for state funding while carrying $5,000,000 in liability coverage (exceeding $2,000,000) justifies granting priority financial awards."
  ],
  "m_0068": [
   "Employing 5 certified pharmacists meets the requirement of at least 3 pharmacists."
  ],
  "m_65e8": [
   "Logging 0 security incidents this quarter meets the requirement of no more than 1 incident."
  ],
  "m_aab6": [
   "A nurse to patient ratio of 0.25 exceeds the required baseline proportion of 0.20."
  ],
  "m_6fbd": [
   "Holding a valid state healthcare license confirms legal operating status."
  ],
  "m_2d70": [
   "Processing 12,000 diagnostic samples this year satisfies the minimum throughput standard of 10,000 samples."
  ]
 },
