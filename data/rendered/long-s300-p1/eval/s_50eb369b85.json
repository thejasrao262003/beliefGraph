  ],
  "m_7ffe": [
   "Vanguard Mobility qualifies through logging 12 monthly emergency transport reroutings, exceeding the minimum requirement of 10.",
   "Vanguard Mobility qualifies through achieving 40 monthly group bookings, exceeding the minimum requirement of 35.",
   "Vanguard Mobility qualifies through recording 25 monthly VIP transfers, exceeding the minimum requirement of 20."
  ],
  "m_b846": [
   "AeroJet Charters meets the standard with a fleet count of 12 against a threshold of 10 and a quarterly punctual departure score of 92 percent against a required 90 percent."
  ],
  "m_80b1": [
   "AeroJet Charters holds premier operator standing and maintains a valid FAA Part 135 Air Carrier Certificate, satisfying both required conditions."
  ],
  "m_2b0e": [
   "Beacon Transit fulfills the criterion by operating 150 daily active routes during the quarter against the threshold of 120."
  ],
  "m_7bbd": [
   "Cascade Excursions holds a verified Master Tour Operator License, satisfying the required credential."
  ]
