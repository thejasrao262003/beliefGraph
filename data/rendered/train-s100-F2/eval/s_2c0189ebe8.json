   "Nexus 400 has a warranty duration of 10 years, which exceeds the 8-year requirement for high-performance status."
  ],
  "m_e0fc": [
   "Nexus 400 satisfies high-performance benchmark criteria, qualifying it for municipal deployment authorization."
  ],
  "m_84aa": [
   "Nexus 400 is approved for municipal deployment and maintains a flow rate of 15 gallons per minute, satisfying the 12 gallons per minute threshold for commercial utility qualification."
  ],
  "m_fc59": [
   "Nexus 400 meets commercial utility specifications and maintains a maximum operating pressure of 120 pounds per square inch, satisfying the 100 pounds per square inch requirement for municipal station purchasing."
  ],
  "m_3f1d": [
   "AeroVent 200 holds Energy Star certification, satisfying the requirement for green building compliance."
  ],
  "m_4ebd": [
   "HydroFlow 90 has a motor capacity of 50 horsepower, meeting the minimum 40 horsepower requirement for a heavy-duty operational rating."
  ]
 },
