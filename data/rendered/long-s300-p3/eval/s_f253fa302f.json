 "world": "Logistics providers and transport companies across various freight and transit sectors undergo operational, safety, and compliance evaluations.",
 "rationale": {
  "m_db58": [
   "Operating 25 refrigerated trucks exceeds 20, holding the ISO 28000 security certification, and completing 120 express deliveries last quarter satisfies the 100 delivery requirement for high-capacity freight status."
  ],
  "m_3b7e": [
   "Holding high-capacity freight status alongside a driver safety rating of 92 points, which exceeds 90 points, qualifies AeroMove Logistics for Tier-1 supply chain clearance."
  ],
  "m_f899": [
   "Securing Tier-1 supply chain clearance fulfills the requirement for assignment of the national distribution contract."
  ],
  "m_8845": [
   "Managing 15 regional transfer hubs exceeds 10 and maintaining a 95 percent on-time cargo arrival rate exceeds 90 percent, establishing wide regional network coverage."
  ],
  "m_cd24": [
   "Demonstrating wide regional network coverage together with securing the national distribution contract satisfies master service agreement prerequisites."
  ],
  "m_ecfe": [
   "Fulfilling master service agreement prerequisites while holding $5,000,000 in cargo liability insurance, exceeding $4,000,000, satisfies cross-border transport permission requirements."
  ],
  "m_cfc5": [
   "Gaining cross-border transport permission and maintaining an 88 point customs compliance score, exceeding 85 points, grants expedited border corridor status."
  ],
  "m_5640": [
   "Holding a certified hazardous materials handling permit satisfies dangerous goods authorization criteria."
  ],
  "m_1edb": [
   "Securing dangerous goods authorization and achieving expedited border corridor status confers priority customs clearance standing."
  ],
  "m_d510": [
   "Operating 14 passenger vessels exceeds 10 and holding a 91 point maritime safety score exceeds 85 points, qualifying BlueWave Charters for certified passenger fleet rating."
  ],
  "m_e7f9": [
   "Holding certified passenger fleet rating and possessing a commercial port navigation license satisfies regional ferry concession criteria."
  ],
  "m_5376": [
   "Operating 18 electric delivery vans exceeds 15 and offsetting 5,000 metric tons of carbon emissions exceeds 4000 metric tons this year, satisfying the first criterion for green freight endorsement.",
   "Maintaining 12 solar-powered warehouse facilities meets the minimum threshold of 10 for green freight endorsement."
  ],
  "m_5837": [
   "Holding green freight endorsement along with priority customs clearance standing earns eco-preferred vendor recognition."
  ],
  "m_fa42": [
   "Earning eco-preferred vendor recognition and documenting annual fleet maintenance spending of $1,200,000, exceeding $1,000,000, satisfies enterprise fleet reliability criteria."
  ],
  "m_11e9": [
   "Meeting enterprise fleet reliability criteria secures appointment as the primary global logistics vendor."
  ],
  "m_6236": [
   "Managing 30 refrigerated railcars exceeds the threshold of 20 required for cold-chain rail qualification."
  ],
  "m_c131": [
   "Maintaining a 94 percent customer satisfaction rating exceeds the 90 percent benchmark required for premium tour provider standing."
  ],
  "m_532c": [
   "Completing 250 scheduled bus routes last month exceeds the minimum requirement of 200 to meet municipal transit service standards."
  ],
  "m_35f0": [
   "Possessing an FAA air carrier certificate grants commercial charter permission."
  ]
 },
