 "world": "A technical safety board evaluates product eligibility and commercial clearance for drones and power equipment.",
 "rationale": {
  "m_9138": [
   "AeroGlide X1 satisfies safety baseline clearance because its wind resistance speed of 55 km/h meets the 50 km/h threshold and it holds CE Mark safety certification."
  ],
  "m_97e1": [
   "AeroGlide X1 achieves commercial drone qualification because it satisfies safety baseline clearance."
  ],
  "m_6cc1": [
   "AeroGlide X1 is permitted for municipal overflight because it holds commercial drone qualification and its parachute deployment response time of 0.8 seconds is below 1.0 seconds."
  ],
  "m_c668": [
   "AeroGlide X1 receives elevated hazard authorization because it is permitted for municipal overflight and holds 5,000,000 USD in annual operational insurance coverage, exceeding the 2,000,000 USD requirement."
  ],
  "m_76fd": [
   "AeroGlide X1 is designated for urgent relief dispatch because it holds elevated hazard authorization and logged 120 autonomous night flight hours this year, surpassing the 100-hour threshold."
  ],
  "m_392e": [
   "SolarPulse Max achieves premium grid interconnection eligibility because its peak efficiency rating of 98.5 percent exceeds the required 97.0 percent."
  ]
 },
