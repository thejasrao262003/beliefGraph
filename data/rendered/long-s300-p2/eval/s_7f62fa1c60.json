   "Apex Medical Center satisfies educational readiness requirements (B2) and is selected for regional expansion funding (D1)."
  ],
  "m_097e": [
   "Apex Medical Center holds operational growth authorization (B3) and maintains $500,000 (>= $400,000) in emergency medical reserves."
  ],
  "m_2ae5": [
   "Apex Medical Center satisfies Set 1 with 4 safety incidents (< 6) last quarter, $150,000 (>= $100,000) annual equipment maintenance expenditure, and 8 (<= 10) operational compliance breaches this year.",
   "Apex Medical Center satisfies Set 2 by holding Joint Commission Accreditation."
  ],
  "m_4753": [
   "Apex Medical Center satisfies facility safety certification standards (B4) and is designated as a regional trauma care provider (D2)."
  ],
  "m_d95c": [
   "Apex Medical Center holds advanced clinical standing (B5) and maintains 20 (>= 15) ICU beds."
  ],
  "m_cf21": [
   "Apex Medical Center recorded 8 (<= 10) operational compliance breaches this year, a 98% (>= 95%) biohazard waste containment rate this quarter, and $150,000 (>= $120,000) in annual equipment maintenance expenditure."
  ],
  "m_5562": [
   "Apex Medical Center fulfills environmental safety conditions (B6) and maintains a nurse-to-patient ratio of 0.25 (>= 0.20)."
  ],
  "m_14fb": [
   "Apex Medical Center achieves primary healthcare facility accreditation (B7)."
  ],
  "m_4512": [
   "Apex Medical Center logged 150 hours (>= 100 hours) of community health outreach this year."
  ],
  "m_904a": [
   "Apex Medical Center holds civic engagement recognition (B8) and is designated as a regional trauma care provider (D2)."
  ],
  "m_7caa": [
   "BioHealth Labs holds an active CLIA Laboratory Certificate."
  ],
  "m_d505": [
   "Crestview Pharmacy maintains an annual prescription accuracy rate of 99.5% (>= 98.0%)."
  ],
  "m_ce16": [
