 "world": "Travel logistics evaluation of regional transportation, charter, and shuttle service providers.",
 "rationale": {
  "m_461f": [
   "Apex Express holds an active ISO 9001 quality certification, which meets the requirement for quality management clearance."
  ],
  "m_4dd5": [
   "Apex Express has quality management clearance, satisfying the condition for corporate transport contract approval."
  ],
  "m_97eb": [
   "Apex Express completed 12 safety audits last year (threshold 10), maintains a fleet size of 25 vehicles (threshold 20), and achieved an 88 percent customer satisfaction rating (threshold 85 percent), satisfying the primary criteria for an exemplary safety record.",
   "Apex Express holds a Gold Fleet Safety Award, satisfying the alternative requirement for an exemplary safety record."
  ],
  "m_bdbd": [
   "Apex Express maintains an exemplary safety record and is approved for corporate transport contracts, fulfilling all requirements for priority route allocation."
  ],
  "m_6e67": [
   "Apex Express has earned priority route allocation, which satisfies the requirement for preferred carrier status."
  ],
  "m_3166": [
   "Apex Express holds preferred carrier status and maintains 5 million USD in liability insurance coverage, satisfying the criteria for long-term route dispatch."
  ],
  "m_cd60": [
   "BlueWave Tours maintains a driver training index of 90 percent, which meets the 85 percent threshold for driver excellence certification."
  ],
  "m_0d27": [
   "BlueWave Tours achieved driver excellence certification, qualifying it for VIP shuttle operations."
  ],
  "m_8641": [
   "Apex Express recorded 15 million USD in annual revenue last year, meeting the 10 million USD threshold for core operational requirements.",
   "Apex Express holds a Class A Transport Licence, satisfying the alternative criterion for core operational requirements."
  ],
  "m_076c": [
   "Apex Express satisfies core operational requirements and is chosen for long-term dispatch, fulfilling all conditions for master logistics provider standing."
  ],
  "m_536d": [
   "Crestline Shuttles logged an annual fuel efficiency of 14 miles per gallon last year, exceeding the 12 miles per gallon threshold."
  ],
  "m_8548": [
   "Delta Aviation achieved a 92 percent on-time arrival rate this quarter, exceeding the 90 percent threshold for air service reliability standards.",
   "Delta Aviation holds an IATA Operational Safety Audit certification, satisfying the alternative condition for air service reliability standards."
  ],
  "m_9642": [
   "Delta Aviation meets air service reliability standards and maintains an active hangar maintenance agreement, fulfilling the requirements for active flight clearance."
  ],
  "m_ff8a": [
   "Delta Aviation maintains active flight clearance, meeting the requirement for peak schedule slot allocation."
  ],
  "m_4c57": [
   "Eagle Cargo maintains 50 certified logistics specialists, exceeding the threshold of 40 required for staffing capability standards."
  ],
  "m_4092": [
   "Horizon Travel holds a Certified Tour Operator badge, fulfilling the requirement for tour accreditation criteria."
  ],
  "m_50e6": [
   "JetStream Charters holds an FAA Part 135 Air Carrier Certificate, satisfying the criteria for commercial charter authorization."
  ]
